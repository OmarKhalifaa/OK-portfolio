{
  "name": "omar-khalifa-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Omar Khalifa portfolio and local Decap CMS workflow",
  "scripts": {
    "serve": "http-server . -p 4173 -c-1",
    "cms": "decap-server",
    "dev": "concurrently --kill-others --names SITE,CMS --prefix-colors cyan,green \"npm:serve\" \"npm:cms\"",
    "validate": "node scripts/validate-content.mjs"
  },
  "devDependencies": {
    "concurrently": "10.0.3",
    "decap-server": "3.9.1",
    "http-server": "14.1.1",
    "js-yaml": "5.2.1"
  }
}
